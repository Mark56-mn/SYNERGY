# SYNERGY environment variable contract (ADR-0007).
#
# Names and purposes only — NEVER put real credentials in this file or in any
# tracked file. Copy to a gitignored `.env` locally, or set values in per-environment
# secret storage. Validation is environment-aware: required variables for one
# environment may be optional in development (see web/src/server/env.ts).

# --- Application -------------------------------------------------------------
# APP_ENV: environment name: development | staging | production.
APP_ENV=development
# APP_ORIGIN: canonical origin of this deployment (URLs, redirects, cookie scope).
# Never derived from a request Host for security-sensitive purposes.
APP_ORIGIN=http://localhost:3000

# --- Database (Neon PostgreSQL) — server-side only ----------------------------
# DATABASE_URL: application database connection string.
DATABASE_URL=

# --- Identity (Supabase Auth) — server-side only ------------------------------
# SUPABASE_AUTH_URL: Supabase Auth project base URL.
SUPABASE_AUTH_URL=
# SUPABASE_AUTH_ANON_KEY: public project accessor used SERVER-SIDE to verify
# sessions and drive auth flows. Kept server-side; never shipped to client bundles.
SUPABASE_AUTH_ANON_KEY=

# --- Media provider (Cloudinary) — server-side only ---------------------------
# MEDIA_PROVIDER_ADAPTER: which media adapter this environment uses (stub | cloudinary).
MEDIA_PROVIDER_ADAPTER=stub
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET: only when
# MEDIA_PROVIDER_ADAPTER=cloudinary. Server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Operations ---------------------------------------------------------------
# LOG_LEVEL: log verbosity (debug | info | warn | error).
LOG_LEVEL=info
# RATE_LIMIT_MAX_PER_WINDOW / RATE_LIMIT_WINDOW_SECONDS: default local rate-limit
# configuration for abuse-prone endpoints (auth, messaging, uploads, search).
RATE_LIMIT_MAX_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60

# Background-job / audit configuration is intentionally absent until those
# subsystems are introduced (no REDIS_URL, AUDIT_* for the foundation; see ADR-0007).

# --- Android (public config only) --------------------------------------------
# The Android app has NO secret-bearing environment variables. Only public,
# non-credential configuration such as an API base URL is allowed there; see
# android/README.md. Do NOT add keys here for the Android bundle.
# PUBLIC_API_BASE_URL=https://…  (example only; set per environment outside git)
