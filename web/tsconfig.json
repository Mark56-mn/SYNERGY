{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "eslint.config.mjs",
    "next-env.d.ts",
    "next.config.mjs",
    "postcss.config.mjs",
    "src",
    "tailwind.config.ts",
    "tests",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
